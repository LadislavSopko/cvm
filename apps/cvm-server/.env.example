# Storage Configuration
CVM_STORAGE_TYPE=file
CVM_DATA_DIR=.cvm

# Logging Configuration
CVM_LOG_LEVEL=info  # Options: debug, info, warn, error

# Execution Limits
CVM_MAX_INSTRUCTIONS=10000000    # Max instructions between two CC() calls; stops loops without CC() (0 = unlimited)

# Environment
NODE_ENV=development  # Options: development, production
